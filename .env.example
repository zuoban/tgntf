# Binance HMAC API credentials; never commit actual values.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Create a bot with @BotFather, then start it from your target Telegram account.
TELEGRAM_BOT_TOKEN=
# Numeric private/group chat ID. Supergroup IDs are usually negative.
TELEGRAM_CHAT_ID=

ENABLE_SPOT=true
ENABLE_FUTURES=true
# true: each fill, including partial fills. false: only the final fill of an order.
NOTIFY_PARTIAL_FILLS=true
# Comma-separated Binance symbols excluded from both spot and futures notifications.
# Example: EXCLUDED_SYMBOLS=BTCUSDT,ETHUSDT (case-insensitive; empty means no exclusions).
EXCLUDED_SYMBOLS=
NOTIFY_TIMEZONE=Asia/Shanghai

# Published GHCR image tag used by docker compose pull.
TGNTF_TAG=0.1.1

# Optional overrides (production defaults):
# BINANCE_SPOT_REST_URL=https://api.binance.com
# BINANCE_SPOT_WS_URL=wss://ws-api.binance.com:443/ws-api/v3
# BINANCE_FUTURES_REST_URL=https://fapi.binance.com
# BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/private/ws
# TELEGRAM_API_URL=https://api.telegram.org
# STATE_PATH=data/notifications.db
# HEALTH_ADDR=127.0.0.1:8080
# HTTP_PROXY=http://proxy:7890
# HTTPS_PROXY=http://proxy:7890
# NO_PROXY=127.0.0.1,localhost
